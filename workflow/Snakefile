"""
External bioinformatics tools of the PHANTOM pipeline, as one Snakemake
workflow. Driven by `phantom run` (stages tools.*), which passes everything
machine-specific through --configfile, built from config.toml: absolute paths,
databases, conda environments and thread counts.

    assemblies (S<n>.fa) --> genomad / vibrant / virsorter2      (per sample)
    genomes/<tool>/*.fna --> checkv, phabox2 cherry|phagcn, phanotate
    phanotate ORFs --> phabox2 phavip

Target rules (all_<tool>) select what to build; Snakemake skips outputs that
are up to date and runs independent samples in parallel (--cores).

Installing from scratch: a tool without an [envs] entry in config.toml runs
in a conda environment Snakemake creates from envs/<tool>.yaml (pinned
versions); setup_<tool> rules download a missing database and check that the
tool starts. VIBRANT/PHANOTATE use a local checkout only if [software] names
one, else the bioconda package's command.
"""

import glob
import re
from pathlib import Path

PATHS = config["paths"]  # absolute directories
DATABASES = config["databases"]  # absolute database paths
ENVIRONMENTS = config["envs"]  # conda environment name per tool
THREADS = config["threads"]
SOFTWARE = config["software"]  # absolute paths of local tool checkouts
VIRUS_IDENTIFICATION_TOOLS = config["virus_identification_tools"]  # abbreviation -> tool name, e.g. geN -> genomad
FILENAME_TAGS = config["filename_tags"]  # phabox2 task -> filename tag, e.g. cherry -> CHR
SAMPLES = config.get("samples")  # None = every sample found
SELECTED_TOOLS = config.get("selected_virus_identification_tools") or list(VIRUS_IDENTIFICATION_TOOLS.values())
ABBREVIATION_OF = {name: abbr for abbr, name in VIRUS_IDENTIFICATION_TOOLS.items()}
SETUP = config.get("setup_dir", ".")  # markers of finished setup_<tool> checks
# Databases at the exact versions the published results were produced with:
# downloaded from a fixed URL and verified against a SHA-256 before use.
DB_DOWNLOADS = {
    "genomad": {
        "url": "https://portal.nersc.gov/genomad/__data__/genomad_db_v1.9.tar.gz",
        "sha256": "47a54faa9584422d6ea1328550d0c78d5fc9ac82ddd1ca9532c1ed365c8e572c",
        "folder": "genomad_db",
    },
    "checkv": {
        "url": "https://portal.nersc.gov/CheckV/checkv-db-v1.5.tar.gz",
        "sha256": "10e20b58873dac7862bd7e4379434e93f23968eb1fdd8db5ddcd8e9815f2bc19",
        "folder": "checkv-db-v1.5",
    },
    "phabox2": {
        "url": "https://github.com/KennthShang/PhaBOX/releases/download/v2/phabox_db_v2_2.zip",
        "sha256": "4bdcd1954fff40a84784218828c475f3470cabb831fe65ec74e557d3525f9bc6",
        "folder": "phabox_db_v2_2",
    },
}


def fetch_db(tool, db, tmp):
    """Shell: download the pinned database of `tool`, check its SHA-256,
    unpack it and move it to `db` -- only if `db` does not exist yet."""
    d = DB_DOWNLOADS[tool]
    archive = f"{tmp}/" + d["url"].rsplit("/", 1)[1]
    unpack = (
        f"unzip -q {archive} -d {tmp}"
        if archive.endswith(".zip")
        else f"tar -xzf {archive} -C {tmp}"
    )
    return (
        f"if [ ! -d {db} ]; then rm -rf {tmp} && mkdir -p {tmp} && "
        f"curl -fL --retry 3 -o {archive} {d['url']} && "
        f"echo '{d['sha256']}  {archive}' | sha256sum -c - && "
        f"{unpack} && mv {tmp}/{d['folder']} {db} && rm -rf {tmp}; fi"
    )


def env(tool):
    """An existing environment named in [envs], else the pinned envs/<tool>.yaml."""
    return ENVIRONMENTS.get(tool) or f"envs/{tool}.yaml"


VIBRANT = f"python3 {SOFTWARE['vibrant']}/VIBRANT_run.py" if SOFTWARE.get("vibrant") else "VIBRANT_run.py"
PHANOTATE = f"{SOFTWARE['phanotate']}/phanotate.py" if SOFTWARE.get("phanotate") else "phanotate.py"

wildcard_constraints:
    sample=r"S\d+",
    virus_identification_tool="|".join(VIRUS_IDENTIFICATION_TOOLS.values()),
    base=r"S\d+_[A-Za-z0-9]+",
    task="cherry|phagcn",


def keep(sample):
    return SAMPLES is None or sample in SAMPLES


def assemblies():
    """sample -> assembly: the S<n>.fa links preprocessing.samples makes."""
    found = {}
    for f in sorted(glob.glob(f"{PATHS['assemblies']}/S*.fa")):
        sample = Path(f).stem
        if re.fullmatch(r"S\d+", sample) and keep(sample):
            found[sample] = f
    return found


def genome_bases(tool):
    """Genome registry bases (S1_geN) of one identification tool."""
    bases = [Path(f).stem for f in sorted(glob.glob(f"{PATHS['genomes']}/{tool}/*.fna"))]
    return [b for b in bases if keep(b.split("_")[0])]


# target rules


rule all_genomad:
    input:
        lambda wildcards: [f"{PATHS['genomad']}/{sample}_{ABBREVIATION_OF.get('genomad', 'genomad')}" for sample in assemblies()],


rule all_vibrant:
    input:
        lambda wildcards: [f"{PATHS['vibrant']}/{sample}_{ABBREVIATION_OF.get('vibrant', 'vibrant')}" for sample in assemblies()],


rule all_virsorter2:
    input:
        lambda wildcards: [f"{PATHS['virsorter2']}/{sample}_{ABBREVIATION_OF.get('virsorter2', 'virsorter2')}" for sample in assemblies()],


rule all_checkv:
    input:
        lambda wildcards: [f"{PATHS['checkv']}/{tool}/{base}_ChV" for tool in SELECTED_TOOLS for base in genome_bases(tool)],


rule all_phanotate:
    input:
        lambda wildcards: [
            f"{PATHS['phanotate_proteins']}/{tool}/{base}_PHA_PROT.faa"
            for tool in SELECTED_TOOLS
            for base in genome_bases(tool)
        ],


rule all_phabox2_cherry:
    input:
        lambda wildcards: [
            f"{PATHS['phabox2']}/cherry/{tool}/{base}_{FILENAME_TAGS.get('cherry', 'cherry')}.tsv"
            for tool in SELECTED_TOOLS
            for base in genome_bases(tool)
        ],


rule all_phabox2_phagcn:
    input:
        lambda wildcards: [
            f"{PATHS['phabox2']}/phagcn/{tool}/{base}_{FILENAME_TAGS.get('phagcn', 'phagcn')}.tsv"
            for tool in SELECTED_TOOLS
            for base in genome_bases(tool)
        ],


rule all_phabox2_phavip:
    input:
        lambda wildcards: [
            f"{PATHS['phabox2']}/phavip/{tool}/{base}_PHA_ORFs_{FILENAME_TAGS.get('phavip', 'phavip')}.tsv"
            for tool in SELECTED_TOOLS
            for base in genome_bases(tool)
        ],


# virus identification (geNomad, VIBRANT, VirSorter2)


rule genomad:
    input:
        lambda wildcards: assemblies()[wildcards.sample],
    output:
        directory(f"{PATHS['genomad']}/{{sample}}_{ABBREVIATION_OF.get('genomad', 'genomad')}"),
    params:
        db=DATABASES.get("genomad", ""),
    threads: THREADS.get("genomad", 1)
    conda:
        env("genomad")
    shell:
        "genomad end-to-end --cleanup --splits 8 {input} {output} {params.db}"


rule vibrant:
    input:
        lambda wildcards: assemblies()[wildcards.sample],
    output:
        directory(f"{PATHS['vibrant']}/{{sample}}_{ABBREVIATION_OF.get('vibrant', 'vibrant')}"),
    params:
        vibrant=VIBRANT,
    threads: THREADS.get("vibrant", 1)
    conda:
        env("vibrant")
    shell:
        "{params.vibrant} -i {input} -t {threads} -folder {output}"


rule virsorter2:
    input:
        lambda wildcards: assemblies()[wildcards.sample],
    output:
        directory(f"{PATHS['virsorter2']}/{{sample}}_{ABBREVIATION_OF.get('virsorter2', 'virsorter2')}"),
    threads: THREADS.get("virsorter2", 1)
    conda:
        env("virsorter2")
    shell:
        "virsorter run -w {output} -i {input} --provirus-off --max-orf-per-seq 20 all"


# genome quality (CheckV)


rule checkv:
    input:
        f"{PATHS['genomes']}/{{virus_identification_tool}}/{{base}}.fna",
    output:
        directory(f"{PATHS['checkv']}/{{virus_identification_tool}}/{{base}}_ChV"),
    params:
        db=DATABASES.get("checkv", ""),
    threads: THREADS.get("checkv", 1)
    conda:
        env("checkv")
    shell:
        "checkv end_to_end {input} {output} -d {params.db} -t {threads}"


# ORF calling (PHANOTATE)


rule phanotate_genes:
    input:
        f"{PATHS['genomes']}/{{virus_identification_tool}}/{{base}}.fna",
    output:
        f"{PATHS['phanotate_genes']}/{{virus_identification_tool}}/{{base}}_PHA.gff",
    params:
        phanotate=PHANOTATE,
    conda:
        env("phanotate")
    shell:
        "{params.phanotate} {input} > {output}"


rule phanotate_bed:
    input:
        f"{PATHS['phanotate_genes']}/{{virus_identification_tool}}/{{base}}_PHA.gff",
    output:
        f"{PATHS['phanotate_bed']}/{{virus_identification_tool}}/{{base}}_PHA.bed",
    shell:
        r"""
        awk 'BEGIN{{OFS="\t"}}
        !/^#/ {{
            start=$1; end=$2; strand=$3; chrom=$4
            if (start ~ /^[0-9]+$/ && end ~ /^[0-9]+$/) {{
                if (start < end) {{ print chrom, start-1, end, ".", ".", strand }}
                else {{ print chrom, end-1, start, ".", ".", strand }}
            }}
        }}' {input} > {output}
        """


rule phanotate_orfs:
    input:
        genome=f"{PATHS['genomes']}/{{virus_identification_tool}}/{{base}}.fna",
        bed=f"{PATHS['phanotate_bed']}/{{virus_identification_tool}}/{{base}}_PHA.bed",
    output:
        f"{PATHS['phanotate_orfs']}/{{virus_identification_tool}}/{{base}}_PHA_ORFs.fna",
    conda:
        env("bedtools")
    shell:
        "bedtools getfasta -fi {input.genome} -bed {input.bed} -fo {output} -s"


rule phanotate_proteins:
    input:
        f"{PATHS['phanotate_orfs']}/{{virus_identification_tool}}/{{base}}_PHA_ORFs.fna",
    output:
        f"{PATHS['phanotate_proteins']}/{{virus_identification_tool}}/{{base}}_PHA_PROT.faa",
    conda:
        env("seqkit")
    shell:
        "seqkit translate {input} > {output}"


# PhaBOX2 (cherry, phagcn, phavip)
# PhaBOX2 writes a whole working directory; only the prediction table is kept.


rule phabox2_genome_task:
    input:
        f"{PATHS['genomes']}/{{virus_identification_tool}}/{{base}}.fna",
    output:
        f"{PATHS['phabox2']}/{{task}}/{{virus_identification_tool}}/{{base}}_{{tag}}.tsv",
    wildcard_constraints:
        tag="|".join([FILENAME_TAGS.get("cherry", "cherry"), FILENAME_TAGS.get("phagcn", "phagcn")]),
    params:
        db=DATABASES.get("phabox2", ""),
        work=lambda wildcards: f"{PATHS['phabox2']}/{wildcards.task}/{wildcards.virus_identification_tool}/{wildcards.base}_{wildcards.tag}",
    threads: THREADS.get("phabox2", 1)
    conda:
        env("phabox2")
    shell:
        "rm -rf {params.work} && "
        "phabox2 --task {wildcards.task} --dbdir {params.db} --outpth {params.work} "
        "--contigs {input} --threads {threads} && "
        "mv {params.work}/final_prediction/{wildcards.task}_prediction.tsv {output} && "
        "rm -rf {params.work}"


rule phabox2_phavip:
    input:
        f"{PATHS['phanotate_orfs']}/{{virus_identification_tool}}/{{base}}_PHA_ORFs.fna",
    output:
        f"{PATHS['phabox2']}/phavip/{{virus_identification_tool}}/{{base}}_PHA_ORFs_{FILENAME_TAGS.get('phavip', 'phavip')}.tsv",
    params:
        db=DATABASES.get("phabox2", ""),
        work=lambda wildcards: f"{PATHS['phabox2']}/phavip/{wildcards.virus_identification_tool}/{wildcards.base}_PHA_ORFs_{FILENAME_TAGS.get('phavip', 'phavip')}",
    threads: THREADS.get("phabox2", 1)
    conda:
        env("phabox2")
    shell:
        "rm -rf {params.work} && "
        "phabox2 --task phavip --dbdir {params.db} --outpth {params.work} "
        "--contigs {input} --len 0 --threads {threads} && "
        "mv {params.work}/final_prediction/phavip_supplementary/gene_annotation.tsv {output} && "
        "rm -rf {params.work}"


# installation (stage tools.setup)
# Each setup_<tool> downloads the tool's database if its [databases] path does
# not exist yet and records that the tool starts in its environment. The
# database is deliberately NOT a declared output: Snakemake deletes a job's
# existing outputs before running it, which would wipe a multi-GB database
# that is already in place. Only the small <tool>.ok marker is an output.


rule setup_genomad:
    output:
        ok=f"{SETUP}/genomad.ok",
    conda:
        env("genomad")
    params:
        fetch=fetch_db("genomad", DATABASES.get("genomad", ""), f"{SETUP}/genomad.download"),
    shell:
        "{params.fetch} && genomad --version > {output.ok}"


rule setup_checkv:
    output:
        ok=f"{SETUP}/checkv.ok",
    conda:
        env("checkv")
    params:
        fetch=fetch_db("checkv", DATABASES.get("checkv", ""), f"{SETUP}/checkv.download"),
        db=DATABASES.get("checkv", ""),
    shell:
        # CheckV searches its proteins with DIAMOND: build the index if the archive lacks it.
        "{params.fetch} && (cd {params.db}/genome_db && "
        "if [ ! -f checkv_reps.dmnd ]; then diamond makedb --in checkv_reps.faa --db checkv_reps; fi) && "
        "(checkv -h | head -1) > {output.ok}"


rule setup_phabox2:
    output:
        ok=f"{SETUP}/phabox2.ok",
    conda:
        env("phabox2")
    params:
        fetch=fetch_db("phabox2", DATABASES.get("phabox2", ""), f"{SETUP}/phabox2.download"),
    shell:
        "{params.fetch} && (phabox2 -h | head -1) > {output.ok}"


rule setup_virsorter2:
    # `virsorter setup` records the database location in VirSorter2's own
    # configuration, so `virsorter run` needs no --db-dir afterwards.
    output:
        ok=f"{SETUP}/virsorter2.ok",
    params:
        db=DATABASES.get("virsorter2", ""),
    threads: 4
    conda:
        env("virsorter2")
    shell:
        "if [ -n '{params.db}' ] && [ ! -d '{params.db}' ]; then "
        "virsorter setup -d {params.db} -j {threads}; fi && virsorter --version > {output.ok}"


rule setup_vibrant:
    # The bioconda package ships download-db.sh; a local checkout ([software].vibrant)
    # is expected to have its databases set up already.
    output:
        ok=f"{SETUP}/vibrant.ok",
    params:
        checkout=SOFTWARE.get("vibrant", ""),
    conda:
        env("vibrant")
    shell:
        "if [ -z '{params.checkout}' ]; then download-db.sh; fi && "
        "({VIBRANT} --version || true) > {output.ok}"


rule setup_phanotate:
    output:
        ok=f"{SETUP}/phanotate.ok",
    conda:
        env("phanotate")
    shell:
        "{PHANOTATE} -h > /dev/null && echo phanotate > {output.ok}"


rule setup_bedtools:
    output:
        ok=f"{SETUP}/bedtools.ok",
    conda:
        env("bedtools")
    shell:
        "bedtools --version > {output.ok}"


rule setup_seqkit:
    output:
        ok=f"{SETUP}/seqkit.ok",
    conda:
        env("seqkit")
    shell:
        "seqkit version > {output.ok}"
